# ============================================================
# AI Supply Chain Control Tower — Environment Configuration
# ============================================================

# --- Core Security ---
# REQUIRED: Secret key for signing JWT auth tokens. 
# Generate a secure random string with: openssl rand -hex 32
JWT_SECRET=your_secret_key_here_replace_this

# --- Database & Infrastructure ---
# OPTIONAL: SQLite is the default database; no setup required.
# Switch to PostgreSQL in production: postgresql://user:password@localhost:5420/supply_chain
DATABASE_URL=sqlite:///./supply_chain.db

# OPTIONAL: Redis Connection URI (required for Celery task queuing and caching)
# Local setup: redis://localhost:6379/0
# Leave empty to fall back to in-memory mode when running without Redis
REDIS_URL=redis://localhost:6379/0

# --- AI & LLM Advisor Panel ---
# OPTIONAL: Anthropic API key for AI Advisor (RAG pipeline)
# Get a key from: https://console.anthropic.com/
# If left blank, the UI fallback will warn that LLM capabilities are offline
ANTHROPIC_API_KEY=

# --- Application Configuration ---
# API server base URL for dashboard requests
API_URL=http://localhost:8000

# Base directory where CSV datasets are located
DATASET_DIR=./dataset
